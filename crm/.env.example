# --- Banco ---
# Produção: string de conexão do Neon (Dashboard › Connection Details › "Pooled connection")
#   DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Desenvolvimento sem Neon: Postgres embutido em arquivo (um processo por vez)
DATABASE_URL=pglite:./.pglite

# --- Sessão --- (gere com: openssl rand -base64 48)
AUTH_SECRET=  aaa

# --- PresentesIA --- (mesma chave/modelo do agente servem)
OPENAI_API_KEY=
# Vazio = usa LLM_MODEL
IA_MODEL=
LLM_MODEL=

# --- Integração com o agente Lia ---
# Segredo compartilhado entre `npm run sync:agente` e o CRM (mínimo 16 caracteres)
CRM_INTEGRATION_SECRET=
CRM_URL=http://localhost:3200
# Pasta onde o agente grava as conversas (relativa a crm/)
CONVERSAS_DIR=../data/conversas

# Controle da ponte do WhatsApp (npm run whatsapp, na pasta do agente)
PONTE_URL=http://127.0.0.1:3040
