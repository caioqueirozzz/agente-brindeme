# --- Modelo (OpenAI) --- sem chave ou sem LLM_MODEL o agente não sobe
OPENAI_API_KEY=sk-...
# Id do modelo como aparece no painel da OpenAI (gpt-4o-mini = o do piloto, decidido em 20/10)
LLM_MODEL=gpt-4o-mini
# reasoning_effort: none | minimal | low | medium | high | xhigh | max (vazio = padrão do modelo).
# gpt-4o-mini (família gpt-4) não tem raciocínio: deixe VAZIO, senão todo turno dá 400.
# Modelos com raciocínio (gpt-6-*): use none; na verificação de 15/10, low quebrou as ferramentas (issue #7).
LLM_REASONING=
# chat = /v1/chat/completions (padrão, validada nos evals) | responses = /v1/responses (raciocínio + ferramentas, issue #8)
LLM_API=chat
ASSISTANT_NAME=Lia
STORE_NAME=Presentes Especiais

# --- API da loja (Fase 2) ---
# mock = JSONs em mocks/ | http = API real
BRINDEME_MODE=mock
BRINDEME_BASE_URL=https://...
BRINDEME_TOKEN=
# Como o token viaja: bearer (Authorization: Bearer <token>) ou header
BRINDEME_AUTH_SCHEME=header
# Usado só quando BRINDEME_AUTH_SCHEME=header
BRINDEME_AUTH_HEADER=X-Api-Key
BRINDEME_TIMEOUT_MS=10000
BRINDEME_MAX_RETRIES=2
# 429 com Retry-After maior que isto (ms) falha na hora em vez de segurar a conversa
BRINDEME_MAX_ESPERA_RETRY_MS=10000
# O agente não grava orçamento na loja (requisito R5): estima e transfere a ficha para a equipe emitir.

# --- Conhecimento e catálogo (Fase 3) ---
# Só item APROVADO da base de conhecimento chega ao cliente. Ligue (true) apenas
# em desenvolvimento para conversar com a base ainda em rascunho; item com
# [PLACEHOLDER] nunca é servido, mesmo ligado.
KB_INCLUIR_RASCUNHOS=false
# Chamadas simultâneas a GET /product/{id} em npm run sync:catalogo
CATALOGO_CONCORRENCIA=5
# Idade máxima (horas) de um produto no índice antes de ser relido, mesmo sem mudança
CATALOGO_MAX_IDADE_HORAS=24
# Ritmo do sync em req/min. A API corta em 60/min por chave; a outra metade fica para as conversas.
CATALOGO_REQ_POR_MINUTO=30

# --- WhatsApp (Fase 4) ---
AGENTE_PORTA=3030
AGENTE_URL=http://127.0.0.1:3030
WHATSAPP_SESSAO_DIR=data/whatsapp-sessao
# O que a ponte lembra entre reinícios (modo de cada conversa, eventos e avisos pendentes)
PONTE_ESTADO_ARQUIVO=data/ponte-estado.json
CONVERSAS_DIR=data/conversas
TURNO_TETO_MS=90000
RESPOSTAS_POR_HORA=30
# Preencha (só dígitos, com DDI) para parear por código de 8 dígitos em vez de QR
WHATSAPP_PAREAR_TELEFONE=
# Versão do WhatsApp Web para tentar primeiro (vazio = a mais recente)
WHATSAPP_WEB_VERSAO=
# Vazio = responde qualquer número. Lista separada por vírgula restringe (use no primeiro teste)
WHATSAPP_LIBERADOS=
ARTES_DIR=data/artes
LOTE_SILENCIO_MS=5000
LOTE_MAX_MS=30000
LOTE_MAX_MENSAGENS=10
AGENTE_TIMEOUT_MS=120000
AVISO_INSTABILIDADE_MIN=10
ENVIOS_POR_MINUTO=20
VARREDURA_MS=120000

# --- Fase 5: controle em runtime ---
# Ferramentas desligadas no startup (separadas por vírgula; requer restart para mudar).
# Use #desligar <ferramenta> no chip para desligar em runtime sem reiniciar.
FERRAMENTAS_DESLIGADAS=
# Arquivo de estado do kill switch e ferramentas desligadas em runtime (padrão: data/estado-sistema.json)
# ESTADO_SISTEMA_ARQUIVO=data/estado-sistema.json

# --- Fase 6: piloto ---
# Dias sem atividade para npm run limpar:dados considerar conversa/arte/log elegível (issue #4: prazo a decidir com a loja).
# O script só apaga com --executar.
RETENCAO_DIAS=90
